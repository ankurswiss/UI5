<mvc:View xmlns:form="sap.ui.layout.form" controllerName="project1.controller.View4"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:u="sap.ui.unified">


    <Page id="page4" title="Create Bulk Record">
    <content>
      <form:SimpleForm id="_IDGenSimpleForm2" editable="true" >
      <form:content>
       <Label id="_IDGenLabel6" text="Upload the file" ></Label>
      <u:FileUploader id="_IDGenFileUploader" buttonText="Browse" uploadOnChange="true" change="onFileChange"></u:FileUploader>
      </form:content>

       <Table id="employeeTable" items="{/employees}">
            <columns>
                <Column id="_IDGenColumn5" >
                    <Text id="_IDGenText11" text="ID"/>
                </Column>
                <Column id="_IDGenColumn6">
                    <Text id="_IDGenText12" text="Name"/>
                </Column>
            </columns>

            <items>
                <ColumnListItem id="_IDGenColumnListItem2">
                    <cells>
                        <Text id="_IDGenText13" text="{id}"/>
                        <Text id="_IDGenText14" text="{name}"/>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>

      </form:SimpleForm>
      <Button id="_IDGenButton6" text="Create Record" press="OnBulkCreate" ></Button>
    </content>
    </Page>

 



</mvc:View>
